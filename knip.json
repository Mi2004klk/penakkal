{
  "$schema": "https://unpkg.com/knip@5/schema-json.json",
  "ignore": [
    "source-data/**",
    "scripts/**",
    "existing_remote_backup/**"
  ],
  "next": {
    "entry": [
      "next.config.{js,ts,mjs}",
      "src/app/**/*.{js,jsx,ts,tsx}",
      "src/pages/**/*.{js,jsx,ts,tsx}"
    ]
  }
}
