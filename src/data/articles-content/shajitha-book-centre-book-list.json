{"content":"\n<figure><table><tbody><tr><td></td><td><strong>நூல் தலைப்பு</strong></td><td><strong>விலை</strong></td><td><strong>நூல் வகை</strong></td></tr><tr><td></td><td>அல்லுவுலுவு வல்மர்ஜான் (மூலமும் – தமிழாக்கமும்)</td><td>600</td><td>ஹதீஸ்</td></tr><tr><td></td><td>ரியாளுஸ்ஸாலிஹீன் (மூலமும் – தமிழாக்கமும்)</td><td>400</td><td>ஹதீஸ்</td></tr><tr><td></td><td>நபிமார்கள் வரலாறு</td><td>300</td><td>வரலாறு</td></tr><tr><td></td><td>சொர்க்கச் சான்று பெற்ற பத்து சஹாபாக்கள் </td><td>250</td><td>வரலாறு</td></tr><tr><td></td><td>கலீஃபாக்கள் வரலாறு (மஹ்மூத் அஹ்மத் கழன்பர்)</td><td>300</td><td>வரலாறு</td></tr><tr><td></td><td>அல்அதபுல் முஃப்ரத் (மூலமும் – தமிழாக்கமும்)</td><td>350</td><td>ஹதீஸ்</td></tr><tr><td></td><td>குர்ஆனும் நவீன விஞ்ஞானமும்</td><td>60</td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>பிரபல மதங்களின் கடவுட்கொள்கை</td><td>20</td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>இஸ்லாம்-குற்றச்சாட்டுகளும் பதில்களும்</td><td>60</td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>குர்ஆன் இறைவாக்கா?</td><td>35</td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>இஸ்லாம் வழங்கும் பெண்ணுரிமைகள்</td><td>50</td><td>பெண்கள் </td></tr><tr><td></td><td>இந்து சமயமும் – இஸ்லாமும்</td><td>50</td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>விஞ்ஞான ஒளியில் குர்ஆனும் – பைபிளும்</td><td></td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>அசைவ உணவு அனுமதிக்கப்பட்டதா? தடுக்கப்பட்டதா?</td><td>30</td><td>ஒப்பாய்வு </td></tr><tr><td></td><td>உலகின் பல்வேறு மத நூல்களில் முஹம்மது நபி (ஸல்)</td><td>20</td><td>நபி (ஸல்)</td></tr><tr><td></td><td>முதல் மனிதர் ஆதம் (அலைஹிஸ்ஸலாம்)</td><td>60</td><td>வரலாறு</td></tr><tr><td></td><td>இறைவனின் தோழர் இப்ராஹிம் (அலைஹிஸ்ஸலாம்)</td><td>60</td><td>வரலாறு</td></tr><tr><td></td><td>இறையச்சத்தின் இலக்கணம் யூஸுஃப் (அலைஹிஸ்ஸலாம்)</td><td>70</td><td>வரலாறு</td></tr><tr><td></td><td>முதல் இறைத்தூதர் நூஹ் அலைஹிஸ்ஸாம்</td><td>50</td><td>வரலாறு</td></tr><tr><td></td><td>நம்பிக்கையாளர்களின் அன்னையர்</td><td>300</td><td>வரலாறு</td></tr><tr><td></td><td>இறுதித்தூதரின் முன்னறிவிப்புகள்</td><td>25</td><td> நபி (ஸல்)</td></tr><tr><td></td><td>மலக்குகளும் வருவார்கள் கேட்க (தர்பியா கதைகள்)</td><td>35</td><td>கதைகள்</td></tr><tr><td></td><td>தெரியாமல் கொடு தர்மத்தை.. (தர்பியா கதைகள்)</td><td>50</td><td>கதைகள்</td></tr><tr><td></td><td>ஆயிஷா ரழியல்லாஹு அன்ஹா</td><td>250</td><td>வரலாறு</td></tr><tr><td></td><td>குழந்தை வளர்ப்பு என்னும் இஸ்லாமிய கலை</td><td>80</td><td>வரலாறு</td></tr><tr><td></td><td>இளம் வயது சஹாபாக்கள்</td><td>300</td><td>வரலாறு</td></tr><tr><td></td><td>அன்னை கதீஜா (ரழி)</td><td>60</td><td>வரலாறு</td></tr><tr><td></td><td>உமர் கத்தாப் (ரழி) – ஷிப்லி நூமானி (ரஹ்) </td><td>400</td><td>வரலாறு</td></tr><tr><td></td><td>குழந்தைகளுக்கான நல்வழிக்கதைகள்</td><td>50</td><td>கதைகள்</td></tr><tr><td></td><td>இவர்தான் இறைவனின் தூதர்</td><td></td><td>சிறுவர் </td></tr><tr><td></td><td>குழந்தைகளுக்கான நீதிக்கதைகள்</td><td>50</td><td>கதைகள்</td></tr><tr><td></td><td>அர்ஷின் நிழலில்…</td><td>200</td><td>வரலாறு</td></tr><tr><td></td><td>இதாஅத் கட்டுப்பாடு</td><td>25</td><td>நபி (ஸல்)</td></tr><tr><td></td><td>அருள் வடிவானவர் – (நபிகள் நாயகம்) </td><td>150</td><td>வரலாறு</td></tr><tr><td></td><td>இறைநம்பிக்கை ஈமானின் கிளைகள் 70</td><td>25</td><td></td></tr><tr><td></td><td>இஸ்லாமும் பொருளாதாரமும்</td><td>130</td><td>ஒப்பாய்வு</td></tr><tr><td></td><td>அருள்மறை குர்ஆனும் அறிவியல் கண்டுபிடிப்புகளும்</td><td>140</td><td>அறிவியல்</td></tr><tr><td></td><td>கடமைகளும் உரிமைகளும்</td><td>20</td><td></td></tr><tr><td></td><td>அமுத மொழிகள் ஐம்பது</td><td>20</td><td>ஹதீஸ்</td></tr><tr><td></td><td>இறந்தவருக்குக் குர்ஆன் ஓதுதல்</td><td>8</td><td></td></tr><tr><td></td><td>குர்ஆன் குறிப்பேடு</td><td>8</td><td>துஆ</td></tr><tr><td></td><td>அபூர்வ துஆக்கள்</td><td>20</td><td>துஆ</td></tr><tr><td></td><td>அபூர்வ துஆக்கள் (பாக்கெட்)</td><td>10</td><td>துஆ</td></tr><tr><td></td><td>மனிதருள் மாணிக்கம்</td><td>30</td><td>வரலாறு</td></tr><tr><td></td><td>பத்ருப் போர் வரலாறு</td><td></td><td>வரலாறு</td></tr><tr><td></td><td>இறைநம்பிக்கையாளரின் இனிய பண்புகள்</td><td>25</td><td>ஒழுக்கம் </td></tr><tr><td></td><td>நபிகள் நாயகம் நேர்முக வர்ணனை (ஷமாயிலுல் திர்மிதி)</td><td>150</td><td>வரலாறு</td></tr><tr><td></td><td>சொர்க்கம் நரகம்</td><td>20</td><td>கருத்தியல் </td></tr><tr><td></td><td>வேலூர் சிப்பாய் புரட்சி-</td><td>50</td><td>வரலாறு</td></tr><tr><td></td><td>சேரமான் பெருமான்</td><td></td><td>வரலாறு</td></tr><tr><td></td><td>புரட்சி விதைகள்</td><td></td><td>கருத்தியல் </td></tr><tr><td></td><td>கனவுகள்</td><td>20</td><td></td></tr><tr><td></td><td>குர்ஆன் ஒளியில் வினா-விடை</td><td>25</td><td></td></tr><tr><td></td><td>நரக விடுதலைக்கு வழி</td><td>20</td><td></td></tr><tr><td></td><td>உறவுகள் </td><td>25</td><td>வரலாறு</td></tr><tr><td></td><td>பாலஸ்தீன வரலாறு </td><td>80</td><td>வரலாறு</td></tr><tr><td></td><td>விடுதலைப் போரில் உலமாக்களின் பங்கு</td><td>60</td><td></td></tr><tr><td></td><td>அவர்கள் எரிகின்றார்கள்</td><td>25</td><td>வரலாறு</td></tr><tr><td></td><td>மதீனாவில் மாநபிகள்</td><td>100</td><td>வரலாறு</td></tr><tr><td></td><td>கழுகு தேசம் – அமெரிக்க வரலாறு</td><td>60</td><td>வரலாறு</td></tr><tr><td></td><td>நபிகள் நாயகம் அழகிய வரலாறு</td><td>100</td><td>வரலாறு</td></tr><tr><td></td><td>முஸ்லிம் மன்னர்கள் ஆண்ட இந்தியா</td><td>150</td><td>வரலாறு</td></tr><tr><td></td><td>இஸ்லாம் கூறும் பண்பாடுகள்</td><td>70</td><td></td></tr><tr><td></td><td>மதரஸாபட்டிணம்</td><td>150</td><td>வரலாறு</td></tr><tr><td></td><td>தென்னாட்டு வேங்கை திப்பு சுல்தான்</td><td>130</td><td>வரலாறு</td></tr><tr><td></td><td> சதாம் உசேன்</td><td>90</td><td>வரலாறு</td></tr><tr><td></td><td>இஸ்லாத்தின் பார்வையில் விருந்து </td><td>15</td><td></td></tr><tr><td></td><td>அதிசய மனிதன் தஜ்ஜால்</td><td>20</td><td></td></tr><tr><td></td><td>மரணம் முதல் மறுமை வரை</td><td>40</td><td></td></tr><tr><td></td><td>மறுமைக்குப் பிறகு சொர்க்கம் நரகம்</td><td>25</td><td></td></tr><tr><td></td><td>இஸ்லாமிய ஆட்சியில் சிறுபான்மையினரின் உரிமை</td><td>60</td><td>வரலாறு</td></tr><tr><td></td><td>நாம் தேடும் புதிய தலைமுறை</td><td>45</td><td></td></tr><tr><td></td><td>இஸ்லாமிய வழியில் நேர நிர்வாகம்</td><td>70</td><td></td></tr><tr><td></td><td>அரபிமொழி போதினி</td><td></td><td>கல்வி</td></tr><tr><td></td><td>இஸ்லாமிய பாடத்திட்டம் </td><td>50</td><td>கல்வி</td></tr><tr><td></td><td>இஸ்லாமிய பாடத்திட்டம் </td><td>45</td><td>கல்வி</td></tr><tr><td></td><td>இறைநேச செல்வர்களும் ஷைத்தானின் தோழர்களும்</td><td></td><td></td></tr><tr><td></td><td>தொழாதவனுக்குரிய தண்டனை</td><td>25</td><td></td></tr><tr><td></td><td>இப்ராஹிம் நபி வரலாறு</td><td>25</td><td>வரலாறு</td></tr><tr><td></td><td>புறம் இஸ்லாத்தில் ஹராம்</td><td>25</td><td></td></tr><tr><td></td><td>நபிகள் நாயகம் நவின்ற நற்கதைகள்</td><td>30</td><td>கதைகள்</td></tr><tr><td></td><td>குர்ஆனிய பெண்கள்</td><td>30</td><td>வரலாறு</td></tr><tr><td></td><td>இஸ்லாமிய ஒழுக்கவியல்</td><td>12</td><td></td></tr><tr><td></td><td>நபித்தோழர்கள் தியாக வரலாறு</td><td>100</td><td>வரலாறு</td></tr><tr><td></td><td>உள்ளம் அமைதி பெற…</td><td>50</td><td></td></tr><tr><td></td><td>தேன் வியந்தேன்</td><td>120</td><td>அறிவியல்</td></tr><tr><td></td><td>நபிவழித்தொழுகை (முழு விபரத்துடன்) </td><td>70</td><td>தொழுகை</td></tr><tr><td></td><td>மனப்பாடம் செய்வோம் (பாக்கெட்)</td><td>12</td><td>துஆ</td></tr><tr><td></td><td>இஸ்லாத்தில் உடலுறவுச் சட்டங்கள்</td><td>20</td><td></td></tr><tr><td></td><td>ஈமானும் ஷிர்க்கும்</td><td>20</td><td></td></tr><tr><td></td><td>ஜகாத் – சட்டங்களும் விளக்கங்களும்</td><td>100</td><td></td></tr><tr><td></td><td>இஸ்லாமிய திருமணம்</td><td>20</td><td></td></tr><tr><td></td><td>இஸ்லாமிய வழியில் குழந்தை வளர்ப்பு</td><td>25</td><td></td></tr><tr><td></td><td>நபிகளாரின் துணைவியர் – மூஃமின்களின் அன்னையர்</td><td>70</td><td>வரலாறு</td></tr><tr><td></td><td>தொழுகை – பிரார்த்தனை வழிகாட்டி (சிறுவர்களுக்கானது)</td><td>30</td><td>தொழுகை, துஆ</td></tr><tr><td></td><td>இல்லத்தரசிகளின் இஸ்லாமியக் கடமைகள்</td><td>60</td><td></td></tr><tr><td></td><td>இஸ்லாமிய அடிப்படைக் கொள்கை</td><td>100</td><td>கல்வி</td></tr><tr><td></td><td>இதுதான் இஸ்லாம்</td><td>25</td><td></td></tr><tr><td></td><td> நபித்தோழியர் வரலாறு</td><td>100</td><td>வரலாறு</td></tr><tr><td></td><td> பாவமன்னிப்பு</td><td>50</td><td>துஆ</td></tr><tr><td></td><td>வானவர்கள்</td><td>100</td><td>வரலாறு</td></tr><tr><td></td><td>இந்து வேதங்களில் இஸ்லாம்</td><td>20</td><td></td></tr><tr><td></td><td>உலக சமயம் ஒரு தத்துவப் பார்வை</td><td></td><td></td></tr><tr><td></td><td>ஜின்கள் ஓர் ஆய்வு</td><td>25</td><td></td></tr><tr><td></td><td>இதயம் அமைதி பெற…</td><td></td><td></td></tr><tr><td></td><td>இந்து-கிறிஸ்துவ-முஸ்லிம் உரையாடல்</td><td>60</td><td></td></tr><tr><td></td><td>கண்ணாடியாய் இருங்கள்</td><td>25</td><td></td></tr><tr><td></td><td>ஐந்தே நாளில் அரபி</td><td>50</td><td></td></tr><tr><td></td><td>கணவன் மனைவி விரிந்து பரவும் உறவு</td><td>100</td><td></td></tr><tr><td></td><td>முஹம்மது இறைத்தூதர் ஏன்?</td><td>50</td><td></td></tr><tr><td></td><td>திருமணமும் – இல்லறமும்</td><td>30</td><td></td></tr><tr><td></td><td>நபிகள் நாயகம் போதித்த நற்பண்புகள்</td><td>130</td><td></td></tr><tr><td></td><td>மாபெரும் தலைவர் நபிகள் நாயகம்</td><td>40</td><td>வரலாறு</td></tr><tr><td></td><td>குளிப்பு – விதிகளும், முறைகளும்</td><td>25</td><td></td></tr><tr><td></td><td>பேய் பிசாசு உண்டா?</td><td>25</td><td></td></tr><tr><td></td><td>ஜனாஸா தொழுகை-சட்டங்கள்</td><td>80</td><td></td></tr><tr><td></td><td>குர்ஆன் கூறும் சூரிய குடும்பம்</td><td>25</td><td></td></tr><tr><td></td><td>அழகான முஸ்லிம் பெயர்கள்</td><td>60</td><td></td></tr><tr><td></td><td>தொழுகை</td><td>15</td><td></td></tr><tr><td></td><td>தாம்பத்ய வழிகாட்டி</td><td>120</td><td></td></tr><tr><td></td><td>நேற்று – இன்று – நாளை</td><td>50</td><td></td></tr><tr><td></td><td>பிரச்சனைகளும் தீர்வுகளும்</td><td>40</td><td></td></tr><tr><td></td><td>மாவீரர் மருதநாயகம்</td><td>50</td><td>வரலாறு</td></tr><tr><td></td><td>திருக்குர்ஆன் கூறும் பிரார்த்தனைகள்</td><td>25</td><td>துஆ</td></tr><tr><td></td><td>ஹஸன் – ஹுஸைன் (ரழி) தியாக வரலாறு</td><td></td><td>வரலாறு</td></tr><tr><td></td><td>பேய்-பிசாசு-ஆவி</td><td>40</td><td></td></tr><tr><td></td><td>நீக்ரோ தேவதை</td><td>100</td><td>சிறுகதை </td></tr><tr><td></td><td>இறுதித் தூதரின் பிரிவுச் செய்திகள் </td><td>30</td><td></td></tr><tr><td></td><td>பெரும் பாவங்கள் </td><td></td><td>ஹதீஸ்</td></tr><tr><td></td><td>நபிகள் நாயகத்தின் முன்னறிவிப்பு</td><td>120</td><td>ஹதீஸ்</td></tr><tr><td></td><td>நபிகள் நாயகம் இறுதிப் பேருரை </td><td>35</td><td></td></tr><tr><td></td><td>நபிமார்கள் வரலாறு</td><td>300</td><td></td></tr><tr><td></td><td>இறுதி இறைத்தூதர் முஹம்மது (ஸல்) வரலாறு</td><td>30</td><td>வரலாறு</td></tr><tr><td></td><td>விடைபெறும் பயணம்</td><td>60</td><td></td></tr><tr><td></td><td>அல்லாஹ்வின் அற்புத படைப்புகள் </td><td>50</td><td></td></tr><tr><td></td><td>அல்குர்ஆனின் அத்தாட்சிகள்</td><td>25</td><td></td></tr><tr><td></td><td>குழந்தைகள் விரும்பும் குட்டிக்கதைகள்</td><td>50</td><td></td></tr><tr><td></td><td>இஸ்லாம் பயங்கரவாதச் செயலைக் கண்டிக்கிறது</td><td>35</td><td></td></tr><tr><td></td><td>ஒரு முஸ்லிமின் ஒருநாள் வாழ்வு (குர்ஆன், நபிவழியில்)</td><td>80</td><td></td></tr><tr><td></td><td>இஸ்லாமிய வாரிசுரிமைச் சட்டங்கள்</td><td>120</td><td></td></tr><tr><td></td><td>இஸ்லாமிய உண்மைக் கொள்கை -அடிப்படைகளும் முரண்பாடுகளும்</td><td>100</td><td></td></tr><tr><td></td><td>நீங்கள் எங்கு செல்கிறீர்கள்? (டாக்டர்.கே.வி.எஸ்.) </td><td>40</td><td></td></tr><tr><td></td><td>எனது பயணம் (Road to  Makkah) (தமிழாக்கம் -அபுல் ஹஸன் கலாமி)</td><td>200</td><td>வரலாறு</td></tr><tr><td></td><td>கிதாபு தவ்ஹீத் (தமிழாக்கம் : முபாரக் மதனீ)</td><td>100</td><td></td></tr><tr><td></td><td>நாங்கள் ஏன் இஸ்லாத்தை ஏற்றோம்</td><td>70</td><td></td></tr><tr><td></td><td>ஹஜ் உம்ரா வழிகாட்டி (அஷ்ஷேக் அப்துல்லாஹ் பின் பாஸ்(ரஹ்)</td><td></td><td></td></tr><tr><td></td><td>வாழ்க்கையில் வெற்றி பெற… (முஹம்மது சித்தீக்)</td><td></td><td></td></tr><tr><td></td><td>ரமழானை அலங்கரிப்போம் (மவ்லவி நூஹ் மஹ்ழரி)</td><td>25</td><td></td></tr><tr><td></td><td>விடுதலை வேங்கை திப்பு சுல்தான்</td><td>50</td><td>வரலாறு</td></tr><tr><td></td><td>மானுடம் வென்ற உமர் (ரழி) (முஹம்மது யூசுப்)</td><td>60</td><td>வரலாறு</td></tr><tr><td></td><td>இரத்த சிந்தலின் சுவடுகள் (முஹம்மது யூசுப்)</td><td>50</td><td></td></tr><tr><td></td><td>மனிதனுக்கேற்ற மார்க்கம் இஸ்லாம்  (அபூ யஹ்யா)</td><td>25</td><td></td></tr><tr><td></td><td>நோன்பின் சட்டங்கள்  (அபூ யஹ்யா)</td><td>25</td><td></td></tr><tr><td></td><td>செல்போனும் பெண்களும் (அம்ர் பின்த் அப்துல்லாஹ்)</td><td>15</td><td></td></tr><tr><td></td><td>மனிதன் எப்படி வாழ வேண்டும்? (மஸ்தான் அலீ)</td><td>15</td><td></td></tr><tr><td></td><td>சினிமா ஒரு தீமையா? (டாக்டர்.கே.வி.எஸ்.) </td><td>10</td><td></td></tr><tr><td></td><td>திருக்குர்ஆன் நிகழ்த்தி வரும் அற்புதங்கள் (டாக்டர்.கே.வி.எஸ்.) </td><td>25</td><td></td></tr><tr><td></td><td>முத்தலாக் மசோதா – உரிமை மீறும் செயல் (திரு.அ.அன்வர்ராஜா)</td><td>70</td><td></td></tr><tr><td></td><td>புனித பைளிள் ஆண்டவனால் அருளப்பட்டதா? (பழனி பாபா)</td><td>25</td><td></td></tr><tr><td></td><td>மூன்று அடிப்படைகள் (இமாம் முஹம்மது பின் அப்துல் வஹாப்)</td><td></td><td></td></tr><tr><td></td><td>சிலுவை யுத்தங்கள் (மவ்லவி ரமலான் ஸலபி, இலங்கை)</td><td>80</td><td>வரலாறு</td></tr><tr><td></td><td>இஸ்லாத்தில் தோன்றிய வழிகெட்ட பிரிவுகள் (றமழான் ஸலபி)</td><td>110</td><td></td></tr><tr><td></td><td>நோன்பு ஓர் அரிய வாய்ப்பு (மவ்லவி.அபூபக்ர் சித்தீக் மதனீ)</td><td>20</td><td></td></tr><tr><td></td><td>இத்தா-சட்டங்களும் விளக்கமும் (மவ்லவி.இம்தியாஸ் ஸலபி)</td><td>20</td><td></td></tr><tr><td></td><td>ஏசுவை நேசித்தேன்…  (அதிரை அஹ்மத்)</td><td></td><td></td></tr><tr><td></td><td>ஹிஸ்னுல் முஸ்லிம் – முஸ்லிமின் அரண் </td><td>60</td><td>துஆ</td></tr><tr><td></td><td>பித்அத் ஓர் ஆய்வு (ஃபரீத் மவ்லவி, இலங்கை)</td><td>15</td><td></td></tr><tr><td></td><td>உமர் முக்தார் (நாவலர் ஏ.எம்.யூசுப்)</td><td>160</td><td>வரலாறு</td></tr><tr><td></td><td>நபித்தோழர் கேள்வி – நபிகளார் பதில்</td><td>20</td><td></td></tr><tr><td></td><td>குழந்தை மருத்துவம் (டாக்டர் கிஸார் அஹ்மத்)</td><td></td><td>மருத்துவம்</td></tr><tr><td></td><td>பருவமடைதல் முதல் பிரசவித்தல் வரை (டாக்டர் கிஸார் அஹ்மத்)</td><td>80</td><td>மருத்துவம்</td></tr><tr><td></td><td>வழிகாட்டும் வான்மறை (மவ்லவி இல்யாஸ் ரியாஸி)</td><td>100</td><td></td></tr><tr><td></td><td>மனித மனங்களும், இனிய குணங்களும்</td><td>35</td><td></td></tr><tr><td></td><td>காலித் பின் வலீத் (ரழி)   (மஹ்மூத் அஹ்மத் கழன்பர்)</td><td>25</td><td>வரலாறு</td></tr><tr><td></td><td>ஒரு தெய்வமா? பல தெய்வமா? (அப்துல்லாஹ் அடியார்)</td><td>25</td><td></td></tr><tr><td></td><td>இறைத்தூதரின் இனிய வரலாறு (மௌ. அப்துல் ஹபீஸ் ரஹ்மானி)</td><td>50</td><td>வரலாறு</td></tr><tr><td></td><td>இஸ்லாமும் பெண்ணினமும்</td><td>25</td><td></td></tr><tr><td></td><td>மாநபி கூறும் மண்ணறை வாழ்க்கை  (அப்துல் வதூத் ஜிப்ரி)</td><td>25</td><td></td></tr><tr><td></td><td>சொர்க்கம் செல்ல எளிய வழி (மவ்லவி. அன்வருத்தீன் பாகவீ))</td><td>20</td><td></td></tr><tr><td></td><td>இஸ்லாமிய அழைப்புப் பணி (டாக்டர் முஹம்மது அலி) </td><td>30</td><td></td></tr><tr><td></td><td>இஸ்லாமிய கொள்கை விளக்கம் (அப்துல் ஹபீஸ் ரஹ்மானி)</td><td>22</td><td></td></tr><tr><td></td><td>கிறிஸ்தவ நண்பர்களே! கொஞ்சம் சிந்தியுங்கள் (அப்துர் ரஹீம்)</td><td>50</td><td></td></tr><tr><td></td><td>பைபிள் கூறுவது ஒரே இறைவனா? மூன்று ஆண்டவரா?- ”</td><td>60</td><td></td></tr><tr><td></td><td>உம்ரா மற்றும் ஜியாரத் வழிகாட்டி (மவ்லவி இப்னு மர்யம் அல்புகாரி)</td><td>20</td><td></td></tr><tr><td></td><td>ஆலோசனை பொக்கிஷம் – ”</td><td>60</td><td></td></tr><tr><td></td><td>இஸ்லாம் ஓர் எளிய அறிமுகம்</td><td>30</td><td></td></tr><tr><td></td><td>பைஅத் (ஆழ்ந்த இஸ்லாமிய கண்ணோட்டம்) – (ஃபுர்கான்)</td><td>10</td><td></td></tr><tr><td></td><td>இறைவழியில் ஜிஹாத்  – ”</td><td>20</td><td></td></tr><tr><td></td><td>குர்ஆன் மீது முஸ்லிம்களுக்கு உள்ள பொறுப்புகள் – ”</td><td>20</td><td></td></tr><tr><td></td><td>அல்ஃபாத்திஹா (மௌலானா அமீன் அஹ்ஸன்)</td><td>10</td><td></td></tr><tr><td></td><td>ஓரிறைவனை விட்டு வேறிறைவனை வணங்குதல் – ”</td><td>30</td><td></td></tr><tr><td></td><td>இறைத்தூதரைப் பற்றி இறைமறை – ”</td><td>10</td><td></td></tr><tr><td></td><td>இஸ்லாமும் உலக அமைதியும்  (ஷஹீத் செய்யித் குதூப்)</td><td>40</td><td></td></tr><tr><td></td><td>பிறை பார்த்தல் ஓர் ஆய்வு (பேராசிரியர் அப்துஸ் ஸமத்)</td><td>15</td><td></td></tr><tr><td></td><td>ஷியா கொள்கையிலிருந்து மீட்சி  (ஃபர்ஹத் அமீரே ப்ரஹிமி)</td><td>10</td><td></td></tr><tr><td></td><td>வன்முறை:உண்மையை மறைக்கும் கட்டுக்கதைகள் (ராம் புனியானி)</td><td>20</td><td></td></tr><tr><td></td><td> யூத, கிறிஸ்தவ, இஸ்லாமியப் பார்வையில் பெண்</td><td>14</td><td></td></tr><tr><td></td><td>இஸ்லாமிய இல்லறம் (முஹம்மது இப்னு முஸ்தஃபா அல்ஜிபாலீ) </td><td>300</td><td></td></tr><tr><td></td><td>.குடும்பக்கட்டுப்பாடு (எம்.எஸ்.எஸ்.அப்துல் ஹமீது)</td><td>55</td><td></td></tr><tr><td></td><td>.இஸ்லாமும் ஆளுமையும் (ஏ.ஆர்.அப்துல் கனி)</td><td>0</td><td></td></tr><tr><td></td><td>.இஸ். பெயரால் தோன்றிய பிரிவுகள் (மவ். ரிஸ்வான் மதனி)</td><td>200</td><td></td></tr><tr><td></td><td>.உலக சமயங்களும் இஸ்லாமும் (அப்துல் ஹபீஸ் ரஹ்மானி)</td><td>40</td><td></td></tr><tr><td></td><td>நம் குழந்தையும் தொழுகையும் (அப்துல் காலிக்)</td><td>15</td><td></td></tr><tr><td></td><td>ஈஸா (அலை) – ஓர் எளிய அறிமுகம் </td><td>30</td><td></td></tr><tr><td></td><td>தெரிந்ததை சொல்கிறேன் (முஹம்மது அலீ)</td><td>35</td><td></td></tr><tr><td></td><td>நபிகளார் நகைத்த நகைச்சுவைகள் (அன்வருத்தீன் பாகவி)</td><td>20</td><td></td></tr><tr><td></td><td>மங்கையருக்காக (இனிய யோசனைகள்) – (ரமீஜா மீரான்)</td><td>50</td><td></td></tr><tr><td></td><td>இறைவன் அருளிய இயற்கை மருத்துவம் (ரமீஜா மீரான்)</td><td></td><td></td></tr><tr><td></td><td>தடுக்கப்பட்டவைகள் (ஷேக் முஹம்மத் ஸாலிஹ் முனஜ்ஜித்)</td><td>50</td><td></td></tr><tr><td></td><td>அல்குர்ஆன் வசனங்கள் அருளப்பட்ட காரணங்கள்</td><td>200</td><td></td></tr><tr><td></td><td>இனிய நபிமொழிகள் </td><td>60</td><td></td></tr><tr><td></td><td>பழங்களும் பலன்களும் – (டாக்டர் சாதிக்)</td><td>80</td><td>சமையல்</td></tr><tr><td></td><td>நா ஊற வைக்கும் மீன் சமையல் (நூர்ஜஹான் யூசுப்)</td><td>45</td><td>சமையல்</td></tr><tr><td></td><td>நாத்திக நண்பர்களே! நாசத்தை தவிர்ப்பீர்! </td><td>40</td><td></td></tr><tr><td></td><td>வட்டியில்லா இஸ்லாமிய வங்கி (நூ.முஹம்மது கனி)</td><td>40</td><td></td></tr><tr><td></td><td>ஒரு புத்த பிட்சுவின் இஸ்லாமிய தேடல் (முஹிபுல்லாஹ்)</td><td>40</td><td></td></tr><tr><td></td><td>மதீனாவில் மாநபி : நிகழ்வுகளும்-படிப்பினைகளும்</td><td>475</td><td></td></tr><tr><td></td><td>அல்லுவுலுவு வல்மர்ஜான் (மூலமும் – தமிழாக்கமும்)</td><td>600</td><td>ஹதீஸ்</td></tr><tr><td></td><td>மதச்சாயம் பூசி மறைக்கப்பட்ட வரலாறு (அதிரை இப்ராஹீம்)</td><td>110</td><td></td></tr><tr><td></td><td>அல்அதபுல் முஃப்ரத் (மூலமும்-தமிழாக்கமும்)</td><td>350</td><td>ஹதீஸ்</td></tr><tr><td></td><td>ஆயிஷா ரழியல்லாஹு அன்ஹா (சையது சுலைமான் நத்வி)</td><td>250</td><td>வரலாறு</td></tr><tr><td></td><td>முதல் மனிதனின் கதை (மழலை பிரியன்)</td><td>40</td><td></td></tr><tr><td></td><td>தகப்பருல் குர்ஆன் (பாத்திஹா, அல்பகரா விளக்கவுரை)</td><td>490</td><td></td></tr><tr><td></td><td>தகப்பருல் குர்ஆன் (ஆலுஇம்ரான், அன்னிஸா, அல்மாயிதா)</td><td>800</td><td></td></tr><tr><td></td><td>சஹாபாக்கள் வரலாறு</td><td>300</td><td>வரலாறு</td></tr><tr><td></td><td>குழந்தைகளுக்கான நல்வழிக்கதைகள்</td><td>50</td><td></td></tr><tr><td></td><td>இறைநம்பிக்கை கொண்டோரே!</td><td>120</td><td></td></tr><tr><td></td><td>கணவன் மனைவி விரிந்து பரவும் உறவு</td><td>100</td><td></td></tr><tr><td></td><td>முஹம்மது இறைத்தூதர் ஏன்?</td><td>50</td><td></td></tr><tr><td></td><td>குர்ஆனும் வானியலும்</td><td>150</td><td></td></tr><tr><td></td><td>ஒரு முஸ்லிமின் ஒருநாள் வாழ்வு</td><td>80</td><td></td></tr><tr><td></td><td>அன்னை கதீஜா (ரழி)</td><td>60</td><td></td></tr><tr><td></td><td>குழந்தை மனசு (ஹுசைன் பாஷா)</td><td>50</td><td></td></tr><tr><td></td><td>நபிகளாரின் தலைமைத்துவ முன்மாதிரி (கே.தாஜுத்தீன் எம்.ஏ.,)</td><td>60</td><td></td></tr><tr><td></td><td>நபிவழியில் நம் பிரார்த்தனை (மவ்லவி. H. அலீம் அல் புகாரிB.A,)</td><td>25</td><td></td></tr><tr><td></td><td>நபிவழி மருத்துவம்  </td><td>350</td><td>மருத்துவம்</td></tr><tr><td></td><td>குழந்தைகளுக்கான நீதிக்கதைகள் (சையத் அப்துர் ரஹ்மான் உமரி)</td><td>50</td><td></td></tr><tr><td></td><td>தென்னாட்டு வேங்கை திப்பு சுல்தான்  (தாழை மதியவன்)</td><td>130</td><td>வரலாறு</td></tr><tr><td></td><td>இஸ்லாமிய பொருளாதார சிந்தனை (அதிரை இப்ராஹீம்)</td><td>110</td><td></td></tr><tr><td></td><td>.நம்பிக்கையாளர்களின் அன்னையர் (அப்துர் ரஹ்மான் உமரி)</td><td>280</td><td>வரலாறு</td></tr><tr><td></td><td>.நபித்தோழியர் வரலாறு (மவ்லவி.முஹம்மது யூசுப் எஸ்.பி.) </td><td>100</td><td>வரலாறு</td></tr><tr><td></td><td>.இஸ்லாமிய உண்மைக் கொள்கை (முஹம்மது யூசுப் மிஸ்பாஹி)</td><td>100</td><td></td></tr><tr><td></td><td>அருள் வடிவானவர்</td><td>150</td><td></td></tr><tr><td></td><td>நபிகளார் கூறும் நல்லொழுக்கம்</td><td>50</td><td></td></tr><tr><td></td><td>பாவமன்னிப்பு</td><td>50</td><td></td></tr><tr><td></td><td>அத்தாட்சிகள் ( பாகங்கள்)</td><td>3000</td><td></td></tr><tr><td></td><td> ரத்த சரிதம் (ஃபலஸ்தீன் போராட்ட வரலாறு)-அபூஷேக் முஹம்மத்</td><td>350</td><td>வரலாறு</td></tr><tr><td></td><td> வானவர்கள்</td><td>100</td><td></td></tr><tr><td></td><td> இஸ்லாமை பெரியார் ஏற்றாரா? எதிர்த்தாரா?</td><td>70</td><td></td></tr><tr><td></td><td>அல்அஸ்மா வஸ்ஸிஃபாத் </td><td>150</td><td></td></tr><tr><td></td><td>இந்து மதம், பௌத்தம், இஸ்லாம் – ஓர் ஒப்பீட்டாய்வு</td><td>300</td><td></td></tr><tr><td></td><td>என்ஜாய் யுவர் லைஃப் </td><td>400</td><td></td></tr><tr><td></td><td>ஷியாக்கள் – ஓர் இஸ்லாமியப் பார்வை</td><td>120</td><td></td></tr><tr><td></td><td>முஸ்லிம் மன்னர்கள் ஆண்ட இந்தியா (குலாம் ரசூல்)</td><td>400</td><td>வரலாறு</td></tr><tr><td></td><td>ரியா </td><td>80</td><td></td></tr><tr><td></td><td>40 ஹதீஸ் குத்ஸீகள்</td><td>50</td><td></td></tr><tr><td></td><td>இஸ்லாமிய உண்மைக் கொள்கை </td><td>600</td><td></td></tr><tr><td></td><td>திருக்குர்ஆன் தமிழாக்கம் -PAPER BACK</td><td>150</td><td></td></tr><tr><td></td><td>திருக்குர்ஆன் தமிழாக்கம் – HARD BOUND</td><td>250</td><td></td></tr><tr><td></td><td></td><td></td><td></td></tr><tr><td></td><td></td><td></td><td></td></tr></tbody></table></figure>\n\n\n\n<h2 id=\"s-1\">Contact Details</h2>\n\n\n\n<figure><img width=\"446\" height=\"183\" src=\"/media/content/2021/12/shajitha-bank-details.webp\" alt=\"\" loading=\"lazy\" /></figure>\n","quranRefs":[],"hadithRefs":[],"lang":"ta","wordCount":776,"coverSourceUrl":"http://penakkal.local/wp-content/uploads/2021/12/Rattha-saritham.png"}