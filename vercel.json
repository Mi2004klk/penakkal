{
  "crons": [
    {
      "path": "/api/cron/publish",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/trash-purge",
      "schedule": "0 3 * * *"
    },
    {
      "path": "/api/cron/db-dump",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/cron/session-purge",
      "schedule": "0 4 * * 0"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(jpg|jpeg|png|webp|avif|ico|svg|woff2|woff)$",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/_next/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
